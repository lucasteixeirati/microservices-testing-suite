{
  "name": "order-service",
  "version": "1.0.0",
  "description": "Order management microservice",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand --json --outputFile=coverage/test-results.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "app.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
